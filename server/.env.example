# Backend environment variables
PORT=5000
NODE_ENV=development

# MongoDB Atlas connection string (use a dedicated DB name per environment)
MONGODB_URI=

# JWT signing secret - generate a long random string for production
JWT_SECRET=
JWT_EXPIRES_IN=1h

# Comma-separated list of allowed frontend origins (required in production)
# Example: CLIENT_ORIGINS=https://campusfix.example.com,https://www.campusfix.example.com
CLIENT_ORIGINS=

# Cookie SameSite mode. Use 'none' only for cross-site deployments
# (requires HTTPS). Defaults to 'lax'.
# COOKIE_SAMESITE=lax

# Initial admin account for `npm run seed:admin` (never commit real values)
ADMIN_NAME=
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Cloudinary image storage for issue photos (server-side only,
# never expose to the frontend). Optional in dev/test - photo
# uploads fail safely with a clear error when unset.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Transactional email via Resend (https://resend.com).
# Optional - without RESEND_API_KEY emails are logged in dev mode
# and never sent. EMAIL_FROM must be a verified Resend sender.
RESEND_API_KEY=
EMAIL_FROM=CampusFix <noreply@yourdomain.com>

# Public frontend URL used in email links.
CLIENT_URL=http://localhost:5173
